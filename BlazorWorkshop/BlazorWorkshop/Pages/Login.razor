
@page "/Login"




@using BlazorWorkshop.Interface
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage


@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ProtectedSessionStorage SessionStorage





<div class="container d-flex justify-content-center align-items-center vh-100">



    <div class="card shadow-lg" style="width:400px;">



        <div class="card-header"><h3>Job Provider Login</h3></div>



        <div class="card-body">



            <EditForm Model="loginModel" OnValidSubmit="Loginn">

                <DataAnnotationsValidator/>

                <div class="mb-3">

                    <label class="form-label fw-bold">Email : </label>

                    <InputText class="form-control" @bind-Value="loginModel.Email"/>

                </div>



                <div class="mb-3">

                    <label class="form-label fw-bold">Password : </label>

                    <InputText Type="password" class="form-control"   @bind-Value="loginModel.Password"/>

                </div>



                <div class="text-center">

                    <button type="submit" class="btn btn-primary">
                        <i >Login</i>
                    </button>

                </div>


            </EditForm>


            @if(!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-danger text-center mt-3">@message</div>
            }


        </div>



    </div>

</div>


@code
{

    private LoginModel loginModel = new();
    private string message = "";


    private class LoginModel
    {
        public string Email { get; set; }

        public string Password { get; set; }
    }


  

    private async Task Loginn()
    {

        var success = await AuthService.Login(loginModel.Email, loginModel.Password);

        if(success)
        {
            Navigation.NavigateTo("/JobList");
        }

        else
        {
            message = "Invalid login credentials";
        }

    }

}
