@page "/"
@page "/Register"


@using BlazorWorkshop.Dto
@using BlazorWorkshop.Interface
@using BlazorWorkshop.Services

@inject IAuthService AuthService
@inject NavigationManager Navigation





@code 
{

    private JobProviderDto jobProvider = new();

    private string message = "";


    private async Task Registerr()
    {
        var success = await AuthService.Register(jobProvider);

        if(success)
        {
            Navigation.NavigateTo("/Login");
        }

        else
        {
            message = "Email Already Exists.";
        }


    }

}



<div class="container d-flex justify-content-center align-items-center vh-100">

    <div class="card shadow-lg p-4" style="width:400px;">

        <div class="card card-header"><h3>Job Provider Registration</h3></div>


        <div class="card-body">



            <EditForm Model = "jobProvider" OnValidSubmit="Registerr">

                <DataAnnotationsValidator/>


                <div class="mb-3">

                    <label class="form-label fw-bold">Name : </label>

                    <InputText class="form-control" @bind-Value="jobProvider.Name"/>

                </div>


                <div class="mb-3">

                    <label class="form-label fw-bold">Email : </label>

                    <InputText class="form-control" @bind-Value="jobProvider.Email" />

                </div>


                <div class="mb-3">

                    <label class="form-label fw-bold">Password : </label>

                    <InputText class="form-control" @bind-Value="jobProvider.Password" />

                </div>


                <div class="text-center">

                    <button type="submit" class="btn btn-success ">
                        <i class="bg-info bi-person-plus"></i>Register
                    </button>

                </div>


            </EditForm>



            @if(!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-danger text-center mt-3">@message</div>
            }

            <div class="text-center mt-3">
                <p>Already have an account? <a href ="/Login" class="text-decoration-none">Login</a></p>
            </div>



        </div>


    </div>


</div>
