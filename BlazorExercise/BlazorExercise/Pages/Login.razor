@page "/Login"
@using BlazorExercise.Services
@using BlazorExercise.Interface
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage

@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ProtectedSessionStorage SessionStorage



@code 
{
    private LoginModel loginModel = new();
    private string message = "";

    private class LoginModel
    {
        public string Email { get; set; }
        public string Password { get; set; }
    }


    private async Task Loginn()
    {
        var success = await AuthService.Login(loginModel.Email, loginModel.Password);

        if(success)
        {
            Navigation.NavigateTo("JobList");
        }
        else
        {
            message = "Invalid login Credentials";
        }

    }


}




<div class="container-fluid vh-100 d-flex justify-content-center align-items-center bg-light">
    <div class="row w-75 shadow-lg rounded overflow-hidden">

       
        <div class="col-md-6 bg-white p-5 d-flex flex-column justify-content-center">
            <h2 class="mb-4 text-center fw-bold">Welcome Back</h2>

            <button class="btn btn-outline-dark w-100 mb-3">
                <i class="bi bi-google"></i> Log in with Google
            </button>

            <EditForm Model="loginModel" OnValidSubmit="Loginn">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-bold"> Email</label>
                    <InputText class="form-control" @bind-Value="loginModel.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Enter password</label>
                    <InputText Type="password" class="form-control" @bind-Value="loginModel.Password" />
                </div>


                <div class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" />
                    <label class="form-check-label">Keep me logged in</label>
                </div>


                <button type="submit" class="btn btn-primary w-100">Login</button>
            </EditForm>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-danger text-center mt-3">@message</div>
            }

            <div class="text-center mt-3">
                <a href="/register">Don’t have an account yet? <strong>Sign up</strong></a>
            </div>
        </div>

       
        <div class="col-md-6 bg-info d-flex justify-content-center align-items-center">
            <img src="images/padlock.png" alt="Secure Login" style="width: 510px;" />
        </div>
    </div>
</div>

