@page
@model LibraryManagement.Pages.Books.CreateModel
@{
}



<h2> Add Book </h2>

<form method="post">

    <div class="mb-3">

        <label>Book name</label>
        <input asp-for = "Books.Bookname" class="form-control" />

    </div>


    <div class=" mb-3">

        <label>Author</label>
        <input asp-for = "Books.Author" class="form-control" />

    </div>


    <div class="mb-3">

        <label>Price</label>
        <input asp-for = "Books.Price" class="form-control" />

    </div>

    <button type="submit" class="btn btn-primary">Save</button>

</form>





