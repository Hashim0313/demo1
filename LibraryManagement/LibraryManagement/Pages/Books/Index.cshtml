@page
@model LibraryManagement.Pages.Books.IndexModel
@{
}



<h2>Book List</h2>

<a asp-page="Create" class=" btn btn-primary"> Add Book </a>

<table class=" table table-bordered mt-3">

    <thead>

        <tr>

            <th>BookName</th>
            <th>Author</th>
            <th>Price</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var book in Model.BookList)
        {
            <tr>

                <td>@book.Bookname</td>
                <td>@book.Author</td>
                <td>@book.Price</td>

                <td>
                    <a asp-page="Edit" asp-route-id="@book.BookId" class=" btn btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@book.BookId" class=" btn btn-danger">Delete</a>

                </td>

            </tr>
        }

    </tbody>

</table>
