@page
@model RazorExercise.Pages.Userpage.LoginModel
@{
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow-lg border-0 rounded-4">

            <!-- Header -->
            <div class="card-body text-center pb-2">
                <div class="mb-3">
                    <i class="bi bi-person-circle text-primary" style="font-size: 3rem;"></i>
                </div>
                <h3 class="fw-bold mb-0">Welcome Back</h3>
                <p class="text-muted mt-1">Login to your account</p>
            </div>

            <hr class="my-0">

            <div class="card-body px-4 pt-4">

                <form method="post">

                    <!-- Email -->
                    <div class="mb-4">
                        <label asp-for="NewLogUser.Email" class="form-label fw-semibold">
                            Email Address
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="NewLogUser.Email" type="email"
                                   class="form-control" placeholder="Enter email" required />
                        </div>
                        <span asp-validation-for="NewLogUser.Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label asp-for="NewLogUser.Password" class="form-label fw-semibold">
                            Password
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="NewLogUser.Password" type="password"
                                   class="form-control" placeholder="Enter password" required />
                        </div>
                        <span asp-validation-for="NewLogUser.Password" class="text-danger small"></span>
                    </div>

                    <!-- Button -->
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary fw-semibold py-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </button>
                    </div>

                    <!-- Register Link -->
                    <div class="text-center mt-3 mb-3">
                        <span class="text-muted">Don't have an account?</span>
                        <a href="/Userpage/Register" class="fw-semibold text-decoration-none"> Register</a>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>
