@page
@model RazorExercise.Pages.Userpage.RegisterModel
@{
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="col-md-6 col-lg-5">

        <div class="card shadow-lg border-0 rounded-4">

            <!-- Header -->
            <div class="card-body text-center pb-2">
                <div class="mb-3">
                    <i class="bi bi-person-plus-fill text-success" style="font-size: 3rem;"></i>
                </div>
                <h3 class="fw-bold mb-0">Create Account</h3>
                <p class="text-muted mt-1">Join us by creating a new account</p>
            </div>

            <hr class="my-0">

            <div class="card-body px-4 pt-4">

                <form method="post">

                    <!-- Name -->
                    <div class="mb-4">
                        <label asp-for="NewUser.Name" class="form-label fw-semibold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-person-fill"></i>
                            </span>
                            <input asp-for="NewUser.Name" type="text"
                                   class="form-control" placeholder="Enter your full name" required />
                        </div>
                        <span asp-validation-for="NewUser.Name" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-4">
                        <label asp-for="NewUser.Email" class="form-label fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="NewUser.Email" type="email"
                                   class="form-control" placeholder="Enter your email" required />
                        </div>
                        <span asp-validation-for="NewUser.Email" class="text-danger small"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label asp-for="NewUser.Password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="NewUser.Password" type="password"
                                   class="form-control" placeholder="Create a password" required />
                        </div>
                        <span asp-validation-for="NewUser.Password" class="text-danger small"></span>
                    </div>

                    <!-- Register button -->
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary fw-semibold py-2">
                            <i class="bi bi-check-circle-fill me-2"></i>Register
                        </button>
                    </div>

                    <!-- Login link -->
                    <div class="text-center mt-3 mb-3">
                        <span class="text-muted">Already have an account?</span>
                        <a href="/Userpage/Login" class="fw-semibold text-decoration-none"> Login</a>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>
