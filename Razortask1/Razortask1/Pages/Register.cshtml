@page
@model Razortask1.Pages.RegisterModel
@{
}

<style>
    body {
        background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
        background-attachment: fixed;
    }

    .register-card {
        backdrop-filter: blur(12px);
        background: rgba(255, 255, 255, 0.85);
        border-radius: 18px;
        transition: 0.3s ease-in-out;
    }

    .register-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .btn-success {
        border-radius: 10px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-success:hover {
        transform: scale(1.03);
        background-color: #2e7d32;
    }

    .form-control, .form-select {
        border-radius: 10px;
        padding: 12px;
    }

    .form-label {
        font-size: 0.95rem;
        color: #2e7d32;
    }

    .header-title {
        background: linear-gradient(90deg, #2e7d32, #43a047);
    }
</style>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 register-card">
                <div class="card-header text-white header-title rounded-top">
                    <h3 class="mb-0 text-center">
                        <i class="bi bi-person-plus-fill me-2"></i>Create Your Account
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <div class="mb-4">
                            <label asp-for="NewUser.Name" class="form-label fw-semibold">
                                <i class="bi bi-person-fill me-2"></i>Name
                            </label>
                            <input type="text" asp-for="NewUser.Name" class="form-control" placeholder="Enter your full name" required />
                            <span asp-validation-for="NewUser.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewUser.Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope-fill me-2"></i>Email
                            </label>
                            <input type="email" asp-for="NewUser.Email" class="form-control" placeholder="Enter your email address" required />
                            <span asp-validation-for="NewUser.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewUser.Password" class="form-label fw-semibold">
                                <i class="bi bi-lock-fill me-2"></i>Password
                            </label>
                            <input type="password" asp-for="NewUser.Password" class="form-control" placeholder="Create a secure password" required />
                            <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NewUser.Role" class="form-label fw-semibold">
                                <i class="bi bi-person-badge-fill me-2"></i>Role
                            </label>
                            <select asp-for="NewUser.Role" class="form-select" required>
                                <option value="" disabled selected>Select role</option>
                                <option value="PATIENT">PATIENT</option>
                                <option value="ADMIN">ADMIN</option>
                            </select>
                            <span asp-validation-for="NewUser.Role" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-check-circle-fill me-2"></i>Register
                            </button>
                        </div>

                        <div class="text-danger mb-3">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        </div>

                        <div class="text-center mt-3">
                            <a href="/Login" class="text-success fw-semibold text-decoration-none">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Already have an account? Login
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
