@page
@model Razortask1.Pages.Appointmentpage.CreateApModel
@{
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="bi bi-calendar-plus me-2"></i> Add Appointment</h3>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-4">
                    <label asp-for="Appointments.PatientName" class="form-label fw-semibold">
                        <i class="bi bi-person-fill me-2"></i>Patient Name
                    </label>
                    <input asp-for="Appointments.PatientName" class="form-control" placeholder="Enter patient's full name" />
                </div>

                <div class="mb-4">
                    <label asp-for="Appointments.AppointmentDate" class="form-label fw-semibold">
                        <i class="bi bi-clock-fill me-2"></i>Appointment Date
                    </label>
                    <input asp-for="Appointments.AppointmentDate" class="form-control" type="date" />
                </div>

                <div class="mb-4">
                    <label asp-for="Appointments.DoctorId" class="form-label fw-semibold">
                        <i class="bi bi-person-badge-fill me-2"></i>Select Doctor
                    </label>
                    <select asp-for="Appointments.DoctorId" asp-items="Model.DoctorList" class="form-select">
                        <option value="">-- Select Doctor --</option>
                    </select>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-save-fill me-2"></i>Save Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>